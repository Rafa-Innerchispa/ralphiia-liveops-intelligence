# Workshop names (Step 1 — https://you.com/platform/api-keys)
YDC_API_KEY=
YOUCOM_API_KEY=

# Mode: live | fixture | auto (default auto)
LIVEOPS_DATA_MODE=auto

# Isolated staging port
LIVEOPS_PORT=8788

# WhatsApp alert when someone runs analysis (use contact_ref OR E.164 number without +)
LIVEOPS_PUBLIC_URL=https://sworn-profusely-alongside.ngrok-free.dev/liveops
LIVEOPS_WHATSAPP_NOTIFY=true
LIVEOPS_WHATSAPP_CONTACT_REF=
LIVEOPS_WHATSAPP_NUMBER=
RALFIA_OPENAI_ROOT=/home/rlopez/projects/raphiia-openai

# Transport: mcp (default auto uses MCP first), rest, or auto
YOUCOM_TRANSPORT=mcp

# Parasail inference (hackathon partner) — https://www.saas.parasail.io/keys
PARASAIL_API_KEY=
PARASAIL_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
PARASAIL_BASE_URL=https://api.parasail.io/v1

# Hybrid deploy (Render → home lab read-only bridge)
RALFIA_STATUS_URL=https://liveops-bridge.pcdoctor.ai/liveops-bridge/status
RALFIA_STATUS_TOKEN=
LIVEOPS_BRIDGE_TOKEN=
# Optional Cloudflare Access (server-to-server from Render)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
DEPLOY_SURFACE=local

# GitHub incident (act 3) — One MCP only (connect GitHub in One dashboard)
GITHUB_REPO_OWNER=Rafa-Innerchispa
GITHUB_REPO_NAME=ralphiia-liveops-intelligence
GITHUB_TOKEN=
ONE_SECRET=
ONE_GITHUB_CONNECTION_KEY=
LIVEOPS_RENDER_WORKFLOW=false
LIVEOPS_RENDER_WORKFLOW_SERVICE=ralphiia-liveops-investigation
# Optional: web button triggers Render task-runs API (else in-process liveops_pipeline)
RENDER_API_KEY=
RENDER_WORKFLOW_TASK_SLUG=ralphiia-liveops-investigation/run_liveops_investigation
